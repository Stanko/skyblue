{
  "name": "skyblue",
  "version": "2.0.0",
  "devDependencies": {
    "sass": "^1.72.0",
    "vite": "^5.1.6"
  },
  "scripts": {
    "start": "vite",
    "build-all": "npm run build && npm run build-minified",
    "build": "sass sass/skyblue.scss css/skyblue.css --source-map --style expanded",
    "build-minified": "sass sass/skyblue.scss css/skyblue.min.css --source-map --style compressed"
  },
  "dependencies": {
    "bootstrap-icons": "^1.11.3"
  }
}
